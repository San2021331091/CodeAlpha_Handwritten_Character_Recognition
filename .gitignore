.next/
out/
build/
frontend/.next/
frontend/out/
frontend/build/
.turbo/
.parcel-cache/

# TypeScript & bundle build info
*.tsbuildinfo
frontend/*.tsbuildinfo

# Frontend test results & coverage
frontend/test-results/
frontend/playwright-report/
frontend/coverage/

