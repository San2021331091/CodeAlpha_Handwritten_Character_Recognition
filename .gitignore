# ------------------------------------------------------------------------------
# 1. Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env
backend-gateway/.env
ml-service/.env

# Whitelist safe environment templates
!.env.example
!*.env.example
!.env.template
!*.env.template

# Security credentials, private keys & certificates
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
id_rsa*
*.id_rsa

